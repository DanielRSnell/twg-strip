---
interface Props {
  lines: string[];
  tag: string;
}

const { lines, tag } = Astro.props;

const lineHeight = 13;
const firstY = 46 - ((lines.length - 1) * lineHeight) / 2;
---

<svg
  class="h-20 w-20"
  viewBox="0 0 80 80"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${lines.join(" ")} ${tag.toLowerCase()} seal`}
>
  <circle cx="40" cy="40" r="38.5" fill="white" stroke="#0A0A0A" stroke-opacity="0.8" stroke-width="1.5"></circle>
  <circle cx="40" cy="40" r="33" fill="none" stroke="#24ab9d" stroke-width="1" stroke-dasharray="2.5 3.5"></circle>
  <path
    d="M40 14.5l4.5 1.7v3.1c0 2.9-1.9 5.5-4.5 6.5-2.6-1-4.5-3.6-4.5-6.5v-3.1z"
    fill="#24ab9d"
    fill-opacity="0.12"
    stroke="#24ab9d"
    stroke-width="1"></path>
  <path d="M37.4 20.4l1.9 1.9 3.4-3.4" fill="none" stroke="#24ab9d" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
  {lines.map((line, index) => (
    <text
      x="40"
      y={firstY + index * lineHeight}
      text-anchor="middle"
      font-size={line.length > 5 ? 11 : 13}
      font-weight="800"
      letter-spacing="0.5"
      fill="#0A0A0A"
    >
      {line}
    </text>
  ))}
  <text
    x="40"
    y="64"
    text-anchor="middle"
    font-size="6"
    font-weight="700"
    letter-spacing="1.8"
    fill="#24ab9d"
  >
    {tag}
  </text>
</svg>
