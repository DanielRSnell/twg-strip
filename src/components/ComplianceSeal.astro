---
interface Props {
  lines: string[];
  tag: string;
}

const { lines, tag } = Astro.props;

const name = lines.join(" ");
const nameSize = name.length > 8 ? 11 : 13;
---

<svg
  class="h-20 w-auto"
  viewBox="0 0 112 80"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${name} ${tag.toLowerCase()} badge`}
>
  <rect x="1" y="9" width="110" height="62" rx="12" fill="white" stroke="#0A0A0A" stroke-opacity="0.75" stroke-width="1"></rect>
  <rect x="5.5" y="13.5" width="101" height="53" rx="8.5" fill="none" stroke="#24ab9d" stroke-opacity="0.35" stroke-width="0.75"></rect>
  <path d="M56 20 L58.4 24 L56 28 L53.6 24 Z" fill="#24ab9d"></path>
  <text
    x="56"
    y="45"
    text-anchor="middle"
    font-size={nameSize}
    font-weight="800"
    letter-spacing="0.5"
    fill="#0A0A0A"
  >
    {name}
  </text>
  <line x1="42" y1="52" x2="70" y2="52" stroke="#0A0A0A" stroke-opacity="0.12" stroke-width="0.75"></line>
  <text
    x="56"
    y="60.5"
    dx="0.8"
    text-anchor="middle"
    font-size="5.5"
    font-weight="700"
    letter-spacing="1.6"
    fill="#24ab9d"
  >
    {tag}
  </text>
</svg>
