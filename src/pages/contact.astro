---
import Base from "@/layouts/Base.astro";
import ContactForm from "@/components/ContactForm";
import { getEntry } from "astro:content";

const contact = await getEntry("contact", "-index");
const { title, description, meta_title } = contact.data;
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={""}
>
  <section class="relative overflow-hidden bg-primary pt-[110px] pb-[60px] lg:pt-[140px] lg:pb-[80px]">
    <div class="absolute inset-0 bg-gradient-to-br from-primary via-[#0d1117] to-primary"></div>
    <div class="absolute inset-0 opacity-[0.06]" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cpath d=&quot;M0 30h60M30 0v60&quot; stroke=&quot;%23fff&quot; stroke-width=&quot;0.5&quot; fill=&quot;none&quot;/%3E%3C/svg%3E');"></div>
    <div class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full bg-brand/[0.05] blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-20 -left-20 w-[400px] h-[400px] rounded-full bg-[#5969FC]/[0.03] blur-3xl pointer-events-none"></div>

    <div class="container relative z-10">
      <div class="mx-auto max-w-3xl text-center">
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-brand" data-aos="fade-up-sm" data-aos-delay="50">
          Contact
        </p>
        <h1
          class="mb-6 text-3xl md:text-4xl lg:text-5xl font-extrabold text-white leading-[1.1] tracking-tight"
          data-aos="fade-up-sm"
          data-aos-delay="100"
        >
          Let's Talk
        </h1>
        <p class="mx-auto max-w-2xl text-lg text-white/70 leading-relaxed" data-aos="fade-up-sm" data-aos-delay="200">
          Tell us about your infrastructure needs and schedule time with our team.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="mx-auto max-w-4xl">
        <ContactForm client:load />
      </div>
    </div>
  </section>

  <!-- Certifications & Compliance -->
  <section class="section bg-theme-light/50">
    <div class="container">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-brand" data-aos="fade-up-sm">
          Trust & Compliance
        </p>
        <h2
          class="mb-4 text-3xl lg:text-4xl font-bold [&>strong]:text-dark/40"
          data-aos="fade-up-sm"
          data-aos-delay="100"
        >
          Certifications & <strong>Compliance</strong>
        </h2>
        <p class="text-light leading-relaxed" data-aos="fade-up-sm" data-aos-delay="150">
          When you partner with TWG, your vendor security review starts with these already cleared.
        </p>
      </div>
      <div class="mx-auto max-w-5xl">
        <div class="row g-4 justify-center">
          <div class="sm:col-6 lg:col-3" data-aos="fade-up-sm" data-aos-delay="100">
            <div class="relative flex h-full flex-col items-center overflow-hidden rounded-2xl border border-border/60 bg-white p-8 shadow-sm text-center">
              <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand/60 via-brand to-brand/60"></div>
              <div class="mb-4 flex items-center justify-center rounded-lg bg-white p-2">
                <img src="/images/certifications/iso/A-LIGN_ISO-27001.png" alt="ISO 27001 Certification" class="h-20 w-auto object-contain" />
              </div>
              <h3 class="mb-2 text-lg font-semibold text-dark">ISO 27001</h3>
              <p class="text-sm leading-relaxed text-light">Clears vendor security review. Partners can onboard TWG without a separate ISMS assessment.</p>
            </div>
          </div>
          <div class="sm:col-6 lg:col-3" data-aos="fade-up-sm" data-aos-delay="150">
            <div class="relative flex h-full flex-col items-center overflow-hidden rounded-2xl border border-border/60 bg-white p-8 shadow-sm text-center">
              <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand/60 via-brand to-brand/60"></div>
              <div class="mb-4 flex items-center justify-center rounded-lg bg-white p-2">
                <img src="/images/certifications/wbe.webp" alt="WBE Certification" class="h-20 w-auto object-contain" />
              </div>
              <h3 class="mb-2 text-lg font-semibold text-dark">WBE Certified</h3>
              <p class="text-sm leading-relaxed text-light">Partners can count TWG spend toward supplier-diversity requirements in their own bids and contracts.</p>
            </div>
          </div>
          <div class="sm:col-6 lg:col-3" data-aos="fade-up-sm" data-aos-delay="200">
            <div class="relative flex h-full flex-col items-center overflow-hidden rounded-2xl border border-border/60 bg-white p-8 shadow-sm text-center">
              <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand/60 via-brand to-brand/60"></div>
              <div class="mb-4 flex h-20 w-20 items-center justify-center rounded-full bg-brand/10 text-brand">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <h3 class="mb-2 text-lg font-semibold text-dark">NIST Aligned</h3>
              <p class="text-sm leading-relaxed text-light">Controls aligned with NIST CSF, so federal channel partners can reference our posture in their own proposals.</p>
            </div>
          </div>
          <div class="sm:col-6 lg:col-3" data-aos="fade-up-sm" data-aos-delay="250">
            <div class="relative flex h-full flex-col items-center overflow-hidden rounded-2xl border border-border/60 bg-white p-8 shadow-sm text-center">
              <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand/60 via-brand to-brand/60"></div>
              <div class="mb-4 flex h-20 w-20 items-center justify-center rounded-full bg-brand/10 text-brand">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 12h10"/><path d="M12 7v10"/></svg>
              </div>
              <h3 class="mb-2 text-lg font-semibold text-dark">FedRAMP Aligned</h3>
              <p class="text-sm leading-relaxed text-light">Practices aligned with FedRAMP, supporting partners who sell into federal and regulated government environments.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section pt-0">
    <div class="container">
      <div
        data-aos="fade-up"
        data-aos-delay="100"
        class="relative overflow-hidden rounded-3xl bg-primary px-8 py-16 text-white sm:px-16 sm:py-20 lg:px-24 lg:py-24"
      >
        <div class="absolute inset-0 opacity-[0.06]" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cpath d=&quot;M0 30h60M30 0v60&quot; stroke=&quot;%23fff&quot; stroke-width=&quot;0.5&quot; fill=&quot;none&quot;/%3E%3C/svg%3E');"></div>
        <div class="absolute -top-20 -right-20 w-[350px] h-[350px] rounded-full bg-brand/10 blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-32 -left-20 w-[400px] h-[400px] rounded-full bg-brand/[0.06] blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 w-[900px] h-[900px] pointer-events-none opacity-20" aria-hidden="true">
          <div class="absolute inset-0 rounded-full border border-brand/40"></div>
          <div class="absolute inset-[12%] rounded-full border border-brand/30"></div>
          <div class="absolute inset-[24%] rounded-full border border-brand/20"></div>
        </div>

        <div class="relative z-10">
          <h2 class="pb-4 text-center text-3xl font-bold text-white lg:text-4xl [&>strong]:text-white/50">
            Explore our <strong>partners</strong>
          </h2>
          <p class="mx-auto max-w-2xl pb-8 text-center text-white/60">
            See the technology companies we build and deliver Sovereign AI infrastructure with, from accelerator leaders to government distributors.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href="/partners"
              class="group relative z-10 inline-flex items-center gap-2 rounded-full bg-brand px-8 py-3.5 text-sm font-semibold text-white shadow-[0_0_20px_rgba(36,171,157,0.25)] transition-all duration-300 hover:bg-brand/90 hover:shadow-[0_0_30px_rgba(36,171,157,0.35)]"
            >
              Our Partners
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-0.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a
              href="/become-a-partner"
              class="group relative z-10 inline-flex items-center gap-2 rounded-full border border-white/[0.12] bg-white/[0.04] px-8 py-3.5 text-sm font-semibold text-white/90 backdrop-blur-sm transition-all duration-300 hover:bg-white/[0.08] hover:border-white/[0.2]"
            >
              Become a Partner
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-0.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
