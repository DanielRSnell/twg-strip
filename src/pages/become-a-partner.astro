---
import Base from "@/layouts/Base.astro";
import ComplianceSeal from "@/components/ComplianceSeal.astro";
import BecomeAPartnerForm from "@/components/BecomeAPartnerForm";
import PartnerLogoMarquee from "@/components/PartnerLogoMarquee.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { getEntry } from "astro:content";

const partnersEntry = await getEntry("partners", "-index");
const { partners } = partnersEntry.data;

const sortedPartners = [...partners].sort(
  (a, b) => Number(b.featured ?? false) - Number(a.featured ?? false)
);

const hero = {
  eyebrow: "Partner Program",
  title: "Partner with **ThisWay Global**",
  subtitle:
    "Build, deliver, and scale Sovereign AI infrastructure alongside the software that makes it run.",
  content:
    "ThisWay Global is channel-first by design. We go to market through and with our partners, bringing Amalgamy to institutions around the world, and we invest in the partners who invest in us.",
};

const benefits = {
  eyebrow: "Why Partner",
  title: "Why partner with **ThisWay Global**?",
  subtitle:
    "A partnership built to grow your business, not just ours. Here is what you get when you join the ecosystem behind Amalgamy.",
  items: [
    {
      title: "Channel-First by Design",
      description:
        "Our go-to-market runs through partners. Clear rules of engagement, protected deals, and a team that treats your pipeline like our own.",
    },
    {
      title: "Grow Your Practice",
      description:
        "Bring Amalgamy software and services into your infrastructure engagements and build a software practice alongside your hardware business.",
    },
    {
      title: "Win in the Sovereign AI Market",
      description:
        "Sovereign AI is one of the fastest-growing infrastructure opportunities in the world. Lead with a proven control layer instead of building one from scratch.",
    },
    {
      title: "Differentiate Your Offering",
      description:
        "Stand out from commodity resellers and integrators with a governed AI infrastructure story customers cannot get anywhere else.",
    },
    {
      title: "Go to Market Together",
      description:
        "Co-selling, co-marketing, enablement, and engineering support from the first conversation through production deployment.",
    },
    {
      title: "A Complete, Connected Stack",
      description:
        "From accelerators to orchestration to governance, offer customers a full Sovereign AI stack with Amalgamy tying it together.",
    },
  ],
};

const apply = {
  points: [
    "A real conversation with our partner team, not a drip campaign",
    "We come prepared, scoped to your market and your offering",
    "No commitment required to start the conversation",
  ],
};

const benefitIcons = [
  '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  '<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>',
  '<circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>',
  '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>',
  '<line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>',
  '<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>',
];
---

<Base
  title="Become a Partner"
  meta_title="Become a Partner - ThisWay Global"
  description="Build, deliver, and scale Sovereign AI infrastructure alongside ThisWay Global. Apply to join the partner ecosystem behind Amalgamy."
>
  <!-- Hero -->
  <section id="apply" class="relative overflow-hidden bg-primary pt-[110px] pb-[60px] lg:pt-[140px] lg:pb-[80px]">
    <div class="absolute inset-0 bg-gradient-to-br from-primary via-[#0d1117] to-primary"></div>
    <div class="absolute inset-0 opacity-[0.06]" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cpath d=&quot;M0 30h60M30 0v60&quot; stroke=&quot;%23fff&quot; stroke-width=&quot;0.5&quot; fill=&quot;none&quot;/%3E%3C/svg%3E');"></div>
    <div class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full bg-brand/[0.05] blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-20 -left-20 w-[400px] h-[400px] rounded-full bg-[#5969FC]/[0.03] blur-3xl pointer-events-none"></div>

    <div class="container relative z-10">
      <div class="row gy-5 items-center">
        <!-- Left: copy -->
        <div class="lg:col-6">
          <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-brand" data-aos="fade-up-sm" data-aos-delay="50">
            {hero.eyebrow}
          </p>
          <h1
            class="mb-6 text-3xl md:text-4xl lg:text-5xl font-extrabold text-white leading-[1.1] tracking-tight [&>strong]:text-brand [&>strong]:font-extrabold"
            data-aos="fade-up-sm"
            data-aos-delay="100"
            set:html={markdownify(hero.title)}
          />
          <p class="mb-5 max-w-xl text-lg text-white/70 leading-relaxed" data-aos="fade-up-sm" data-aos-delay="200">
            {hero.subtitle}
          </p>
          <p class="mb-8 max-w-xl text-white/50 leading-relaxed" data-aos="fade-up-sm" data-aos-delay="250">
            {hero.content}
          </p>
          <ul class="space-y-4" data-aos="fade-up-sm" data-aos-delay="300">
            {apply.points.map((point) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand/15 text-brand">
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                </span>
                <span class="text-sm leading-relaxed text-white/60">{point}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Right: application form -->
        <div class="lg:col-6 lg:pl-10 xl:pl-14" data-aos="fade-up-sm" data-aos-delay="250">
          <div class="relative">
            <div class="absolute -inset-4 rounded-3xl bg-brand/[0.07] blur-2xl pointer-events-none" aria-hidden="true"></div>
            <BecomeAPartnerForm client:load />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Logo strip -->
  <section class="py-16 lg:py-20">
    <div class="container">
      <p class="mb-10 text-center text-xs font-semibold uppercase tracking-[0.2em] text-light" data-aos="fade-up-sm">
        You will be in good company
      </p>
      <div data-aos="fade-up-sm" data-aos-delay="100">
        <PartnerLogoMarquee partners={sortedPartners} />
      </div>
    </div>
  </section>

  <!-- Why partner -->
  <section class="section bg-theme-light/50">
    <div class="container">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-brand" data-aos="fade-up-sm">
          {benefits.eyebrow}
        </p>
        <h2
          class="mb-4 text-3xl lg:text-4xl font-bold [&>strong]:text-dark/40"
          data-aos="fade-up-sm"
          data-aos-delay="100"
          set:html={markdownify(benefits.title)}
        />
        <p class="text-light leading-relaxed" data-aos="fade-up-sm" data-aos-delay="150">
          {benefits.subtitle}
        </p>
      </div>
      <div class="row g-4">
        {benefits.items.map((item, index) => (
          <div class="md:col-6 lg:col-4" data-aos="fade-up-sm" data-aos-delay={100 + index * 50}>
            <div class="relative h-full overflow-hidden rounded-2xl border border-border/60 bg-white p-8 shadow-sm transition-shadow duration-300 hover:shadow-md">
              <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand/60 via-brand to-brand/60"></div>
              <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-brand/10 text-brand">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={benefitIcons[index % benefitIcons.length]} />
              </div>
              <h3 class="mb-3 text-lg font-semibold text-dark">{item.title}</h3>
              <p class="text-sm leading-relaxed text-light">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Certifications and Compliance -->
  <section class="section pt-0 bg-theme-light/50">
    <div class="container">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-brand" data-aos="fade-up-sm">
          Trust and Compliance
        </p>
        <h2
          class="mb-4 text-3xl lg:text-4xl font-bold [&>strong]:text-dark/40"
          data-aos="fade-up-sm"
          data-aos-delay="100"
        >
          Certifications and <strong>Compliance</strong>
        </h2>
        <p class="text-light leading-relaxed" data-aos="fade-up-sm" data-aos-delay="150">
          Credentials and control documentation partners commonly need during onboarding and deal qualification.
        </p>
      </div>
      <div class="mx-auto max-w-5xl">
        <div class="row g-4 justify-center">
          <div class="sm:col-6 lg:col-3" data-aos="fade-up-sm" data-aos-delay="100">
            <div class="relative flex h-full flex-col items-center overflow-hidden rounded-2xl border border-border/60 bg-white px-4 py-8 shadow-sm text-center">
              <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand/60 via-brand to-brand/60"></div>
              <div class="mb-4 flex items-center justify-center rounded-lg bg-white p-2">
                <img src="/images/certifications/iso/A-LIGN_ISO-27001.png" alt="ISO 27001 Certification" class="h-20 w-auto object-contain" />
              </div>
              <h3 class="mb-2 text-lg font-semibold text-dark">ISO 27001</h3>
              <p class="text-sm leading-relaxed text-light">Clears vendor security review. Partners can onboard TWG without a separate ISMS assessment.</p>
            </div>
          </div>
          <div class="sm:col-6 lg:col-3" data-aos="fade-up-sm" data-aos-delay="150">
            <div class="relative flex h-full flex-col items-center overflow-hidden rounded-2xl border border-border/60 bg-white px-4 py-8 shadow-sm text-center">
              <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand/60 via-brand to-brand/60"></div>
              <div class="mb-4 flex items-center justify-center rounded-lg bg-white p-2">
                <img src="/images/certifications/wbe.webp" alt="WBE Certification" class="h-20 w-auto object-contain" />
              </div>
              <h3 class="mb-2 text-lg font-semibold text-dark">WBE Certified</h3>
              <p class="text-sm leading-relaxed text-light">Partners can count TWG spend toward supplier-diversity requirements in their own bids and contracts.</p>
            </div>
          </div>
          <div class="sm:col-6 lg:col-3" data-aos="fade-up-sm" data-aos-delay="200">
            <div class="relative flex h-full flex-col items-center overflow-hidden rounded-2xl border border-border/60 bg-white px-4 py-8 shadow-sm text-center">
              <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand/60 via-brand to-brand/60"></div>
              <div class="mb-4">
                <ComplianceSeal lines={["NIST", "CSF"]} tag="ALIGNED" />
              </div>
              <h3 class="mb-2 text-lg font-semibold text-dark">NIST CSF Aligned</h3>
              <p class="text-sm leading-relaxed text-light">Security controls mapped to the NIST Cybersecurity Framework, supporting partners in federal and enterprise qualification.</p>
            </div>
          </div>
          <div class="sm:col-6 lg:col-3" data-aos="fade-up-sm" data-aos-delay="250">
            <div class="relative flex h-full flex-col items-center overflow-hidden rounded-2xl border border-border/60 bg-white px-4 py-8 shadow-sm text-center">
              <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand/60 via-brand to-brand/60"></div>
              <div class="mb-4">
                <ComplianceSeal lines={["FedRAMP"]} tag="MAPPED" />
              </div>
              <h3 class="mb-2 text-lg font-semibold text-dark">FedRAMP Baseline Mapping</h3>
              <p class="text-sm leading-relaxed text-light">Controls mapped to the FedRAMP Moderate baseline (NIST SP 800-53), the control set federal buyers assess against.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="section pt-0 bg-theme-light/50">
    <div class="container">
      <div
        data-aos="fade-up"
        data-aos-delay="100"
        class="relative overflow-hidden rounded-3xl bg-primary px-8 py-16 text-white sm:px-16 sm:py-20 lg:px-24 lg:py-24"
      >
        <div class="absolute inset-0 opacity-[0.06]" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cpath d=&quot;M0 30h60M30 0v60&quot; stroke=&quot;%23fff&quot; stroke-width=&quot;0.5&quot; fill=&quot;none&quot;/%3E%3C/svg%3E');"></div>
        <div class="absolute -top-20 -right-20 w-[350px] h-[350px] rounded-full bg-brand/10 blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-32 -left-20 w-[400px] h-[400px] rounded-full bg-brand/[0.06] blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 w-[900px] h-[900px] pointer-events-none opacity-20" aria-hidden="true">
          <div class="absolute inset-0 rounded-full border border-brand/40"></div>
          <div class="absolute inset-[12%] rounded-full border border-brand/30"></div>
          <div class="absolute inset-[24%] rounded-full border border-brand/20"></div>
        </div>

        <div class="relative z-10">
          <h2 class="pb-4 text-center text-3xl font-bold text-white lg:text-4xl [&>strong]:text-white/50">
            Ready to <strong>get started</strong>?
          </h2>
          <p class="mx-auto max-w-2xl pb-8 text-center text-white/60">
            Reach out to our partner team directly. We'll set up a conversation scoped to your market and your offering.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href="mailto:partner@thiswayglobal.com"
              class="group relative z-10 inline-flex items-center gap-2 rounded-full bg-brand px-8 py-3.5 text-sm font-semibold text-white shadow-[0_0_20px_rgba(36,171,157,0.25)] transition-all duration-300 hover:bg-brand/90 hover:shadow-[0_0_30px_rgba(36,171,157,0.35)]"
            >
              Contact Us
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-0.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a
              href="/partners"
              class="group relative z-10 inline-flex items-center gap-2 rounded-full border border-white/[0.12] bg-white/[0.04] px-8 py-3.5 text-sm font-semibold text-white/90 backdrop-blur-sm transition-all duration-300 hover:bg-white/[0.08] hover:border-white/[0.2]"
            >
              Our Partners
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-0.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
